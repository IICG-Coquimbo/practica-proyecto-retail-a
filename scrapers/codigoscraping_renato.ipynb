# --- VARIABLES GENERALES ---
NOMBRE_GRUPO = "Ave Mayo"
SUPERMERCADO = "Unimarc"
URL_BASE = "https://www.unimarc.cl/category/lacteos-huevos-y-refrigerados"

# URI de Atlas
MONGO_URI = "mongodb+srv://FelipeGutierrez:pepe1516@cluster0.6zjv54l.mongodb.net/?appName=Cluster0"


def limpiar_precio(texto):
    """
    Limpieza robusta de precios para Unimarc
    """

    if not texto:
        return 0.0

    texto = texto.strip()

    # Caso promociones tipo: 2 x $1.600
    match_promo = re.search(
        r'(\d+)\s*x\s*\$\s*([\d\.]+)',
        texto,
        re.IGNORECASE
    )

    if match_promo:
        cantidad = int(match_promo.group(1))
        precio_total = float(
            match_promo.group(2).replace(".", "")
        )

        return round(precio_total / cantidad, 0)

    # Caso normal: $1.990
    match_normal = re.search(
        r'\$\s*([\d\.]+)',
        texto
    )

    if match_normal:
        return float(
            match_normal.group(1).replace(".", "")
        )

    numeros = re.findall(r'\d+', texto)

    if numeros:
        return float(numeros[0])

    return 0.0


def ejecutar_extraccion():

    datos_finales = []

    # Cambia a 16 cuando confirmes que funciona
    max_paginas = 16

    driver = None

    try:

        # --- PASO 1: NAVEGADOR ---
        print("🌐 Configurando navegador Headless para Docker...")

        options = Options()

        options.add_argument("--headless=new")
        options.add_argument("--no-sandbox")
        options.add_argument("--disable-dev-shm-usage")
        options.add_argument("--disable-gpu")
        options.add_argument("--window-size=1920,1080")

        options.add_argument(
            "user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/137.0.0.0 Safari/537.36"
        )

        # Selenium Manager obtiene el driver automáticamente
        driver = webdriver.Chrome(options=options)

        print(f"\n🚀 {SUPERMERCADO} iniciado correctamente.")

        # --- RECORRIDO DE PÁGINAS ---
        for pagina_actual in range(1, max_paginas + 1):

            url = (
                URL_BASE
                if pagina_actual == 1
                else f"{URL_BASE}?page={pagina_actual}"
            )

            print("\n" + "=" * 70)
            print(f"🔍 PÁGINA {pagina_actual} DE {max_paginas}")
            print(f"🌐 {url}")
            print("=" * 70)

            driver.get(url)

            try:
                WebDriverWait(driver, 30).until(
                    EC.presence_of_element_located(
                        (By.CSS_SELECTOR, "section.smu-impressed")
                    )
                )
            except:
                print("⚠️ No cargaron productos en esta página.")
                continue

            # Scroll para activar lazy loading
            for _ in range(8):
                driver.execute_script(
                    "window.scrollBy(0,1000)"
                )
                time.sleep(1)

            bloques = driver.find_elements(
                By.CSS_SELECTOR,
                "section.smu-impressed"
            )

            print(
                f"📦 Productos encontrados: {len(bloques)}"
            )

            if len(bloques) == 0:
                continue

            # --- PRODUCTOS ---
            for bloque in bloques:

                try:

                    # -------------------------------
                    # NOMBRE DEL PRODUCTO (ROBUSTO)
                    # -------------------------------
                   
                    nombre_txt = ""
                   
                    selectores_nombre = [
                        "p.Shelf_nameProduct__0KIRG",
                        "p[class*='Shelf_nameProduct']",
                        "p[class*='nameProduct']"
                    ]
                   
                    for selector in selectores_nombre:
                   
                        try:
                   
                            nombre_txt = bloque.find_element(
                                By.CSS_SELECTOR,
                                selector
                            ).text.strip()
                   
                            if len(nombre_txt) > 3:
                                break
                   
                        except:
                            pass
                   
                    # Descartar textos basura
                    if (
                        not nombre_txt
                        or "$" in nombre_txt
                        or nombre_txt.upper() == "DESPENSA"
                        or nombre_txt.upper() == "UNIMARC"
                        or nombre_txt.upper() == "TOTTUS"
                    ):
                        continue
                   
                    # -------------------------------
                    # MARCA
                    # -------------------------------
                   
                    try:
                   
                        marca_txt = bloque.find_element(
                            By.CSS_SELECTOR,
                            "p[class*='Shelf_brandText']"
                        ).text.strip()
                   
                    except:
                   
                        marca_txt = "No especificada"
                   
                    # -------------------------------
                    # PRECIO
                    # -------------------------------
                   
                    try:
                   
                        precio_txt = bloque.find_element(
                            By.CSS_SELECTOR,
                            "p[id^='listPrice__offerPrice--']"
                        ).text.strip()
                   
                    except:
                   
                        continue

                    fecha_actual = time.strftime(
                        "%Y-%m-%d %H:%M:%S"
                    )

                    precio_limpio = limpiar_precio(
                        precio_txt
                    )

                    datos_finales.append({

                        "identificador": nombre_txt.strip(),
                        "valor": precio_limpio,
                        "fecha_capture": fecha_actual,                  
                        "grupo": NOMBRE_GRUPO,                  
                        "nombre_producto": nombre_txt.strip(),
                   
                        "precio": precio_limpio,
                   
                        "supermercado": SUPERMERCADO,
                   
                        "categoria": "Lacteos y Refrigerados",
                   
                        "marca": marca_txt.strip().upper(),
                   
                        "responsable": "Renato",
                   
                        "precio_promedio": 0.0,
                   
                        "fecha_scraping": fecha_actual
                   
                    })

                except Exception as e:
                    print(f"⚠️ Error producto: {e}")
                    continue

            print(
                f"✅ Página {pagina_actual} completada."
            )

    except Exception as e:

        print(f"\n❌ Error durante el scraping:")
        print(e)

    finally:

        if driver:
            driver.quit()
            print("\n🔒 Navegador cerrado.")

    # --- PASO 3: MONGODB + DATAFRAME ---
    if len(datos_finales) > 0:

        try:

            print(
                f"\n☁️ Subiendo {len(datos_finales)} registros a MongoDB..."
            )

            client = MongoClient(
                MONGO_URI,
                serverSelectionTimeoutMS=5000
            )

            db = client["Canasta_db"]
            coleccion = db["Retail_A"]

            coleccion.insert_many(
                datos_finales,
                ordered=False
            )

            print("✅ Datos cargados en MongoDB.")

        except Exception as e:

            print(f"⚠️ MongoDB: {e}")

        df = pd.DataFrame(datos_finales)

        pd.set_option(
            "display.max_columns",
            None
        )

        pd.set_option(
            "display.width",
            1000
        )

        print("\n" + "=" * 120)
        print(
            f"📊 TABLA DE DATOS - {NOMBRE_GRUPO.upper()}"
        )
        print("=" * 120)

        print(
            df.tail(15).to_string(index=False)
        )

        print("=" * 120)
        print(
            f"⭐ TOTAL PRODUCTOS CAPTURADOS: {len(df)}"
        )
        print("=" * 120)

    else:

        print(
            "\n⚠️ No se capturaron productos."
        )

    return datos_finales


if __name__ == "__main__":
    ejecutar_extraccion()
